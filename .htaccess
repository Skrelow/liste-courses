Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config\.php|config\.sample\.php|.*\.sqlite|.*\.md|.*\.yml)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
